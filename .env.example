SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only secret/service-role key. Never use an sb_publishable_ key here.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
SPEECH_SERVICE_URL=http://127.0.0.1:8000
DEMO_MODE=true
# Optional: free AI recommendation on the results page (https://console.groq.com/keys).
GROQ_API_KEY=
